// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`demo instant analysis markup > printed report 1`] = `"<link rel="preload" as="image" href="/src/assets/logos/logo_final.png"/><main class="report-document hidden! print:block!" aria-labelledby="formal-report-title"><header class="formal-report-header"><img src="/src/assets/logos/logo_final.png" alt="RepoPrint"/><div class="formal-report-kicker">SECURITY &amp; PRIVACY ASSESSMENT</div><h1 id="formal-report-title">Repository Security &amp; Privacy Audit Report</h1><dl class="report-metadata"><div><dt>Repository</dt><dd>deti-org/payment-service</dd></div><div><dt>Branch</dt><dd>main</dd></div><div><dt>Commit Hash</dt><dd>a3f89c1</dd></div><div><dt>Analysis Date</dt><dd>15 November 2026</dd></div></dl></header><section class="formal-report-section"><div class="formal-section-title"><span>01</span><h2>Executive Summary &amp; Risk Overview</h2></div><p class="report-lead">5 findings identified across STRIDE threat modeling and LINDDUN privacy analysis, 3 of them rated High.</p><table class="formal-table"><tbody><tr><th>Threat modeling (STRIDE)</th><td>3 findings (1 High, 2 Medium) · Spoofing, webhook tampering, information disclosure</td></tr><tr><th>Privacy (LINDDUN / GDPR)</th><td>2 high risks (Linkability · Detectability) · Personal identifiers in telemetry and transaction logs</td></tr><tr><th>Git intelligence &amp; hygiene</th><td>Grade 97/100 · median PR merge time 4.2h · 47 commits / month · 92% Code Owners coverage</td></tr></tbody></table></section><section class="formal-report-section"><div class="formal-section-title"><span>02</span><h2>Threat Modeling Findings (STRIDE)</h2></div><table class="formal-table"><thead><tr><th>Threat</th><th>Affected file / flow</th><th>Severity</th><th>Impact</th><th>Regulatory controls</th></tr></thead><tbody><tr><td>Spoofing</td><td><code>auth/session.ts</code> · client to API</td><td class="formal-high">High</td><td>Session impersonation and unauthorized account access</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.5.17</td></tr><tr><td>Tampering</td><td><code>payments/webhooks.ts</code> · inbound webhook</td><td class="formal-medium">Medium</td><td>Forged or replayed payment events</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.8.26</td></tr><tr><td>Information Disclosure</td><td><code>storage/users.db</code> · user data store</td><td class="formal-medium">Medium</td><td>Over-exposed personal attributes can be leaked in a data breach</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.8.12</td></tr></tbody></table></section><section class="formal-report-section"><div class="formal-section-title"><span>03</span><h2>Privacy Risk Assessment (LINDDUN)</h2></div><table class="formal-table"><thead><tr><th>Privacy risk</th><th>Affected component</th><th>Severity</th><th>Applicable GDPR articles</th></tr></thead><tbody><tr><td>Linkability</td><td>Telemetry Collector · <code>telemetry/tracker.go</code></td><td class="formal-high">High</td><td>Art. 5(1)(c); Arts. 25, 32</td></tr><tr><td>Detectability</td><td>Telemetry Collector · <code>telemetry/tracker.go</code></td><td class="formal-high">High</td><td>Art. 5(1)(c); Art. 32</td></tr></tbody></table></section><section class="formal-report-section formal-dfd-section"><div class="formal-section-title"><span>04</span><h2>Inferred Architecture &amp; Data Flow Diagram (DFD)</h2></div><p>Primary payment and identity flows inferred from repository structure and analysis findings.</p><div class="formal-dfd-wrap"><svg class="formal-dfd" viewBox="0 0 900 270" role="img" aria-label="DFD: customer client sends authenticated requests to API gateway, which reads and writes payment data in PostgreSQL; webhook provider sends payment events to the gateway"><defs><marker id="formal-dfd-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 8 4 0 8Z" fill="#52525b"></path></marker></defs><path d="M145 124H270M410 124H560M700 124H790M790 178C790 225 405 225 405 170" fill="none" stroke="#52525b" stroke-width="2" marker-end="url(#formal-dfd-arrow)"></path><text x="205" y="108" text-anchor="middle">HTTPS / JWT</text><text x="485" y="108" text-anchor="middle">SQL · payment data</text><text x="748" y="108" text-anchor="middle">write / read</text><text x="590" y="220" text-anchor="middle">signed webhook event</text><rect x="20" y="92" width="125" height="64" rx="3" class="dfd-entity"></rect><text x="82" y="120" text-anchor="middle" class="dfd-label">Customer Client</text><text x="82" y="140" text-anchor="middle" class="dfd-sub-label">EXTERNAL ENTITY</text><circle cx="340" cy="124" r="70" class="dfd-process"></circle><text x="340" y="120" text-anchor="middle" class="dfd-label">API Gateway</text><text x="340" y="140" text-anchor="middle" class="dfd-sub-label">PROCESS</text><path d="M560 96h140v56H560zM572 106h118M572 142h118" class="dfd-store"></path><text x="630" y="130" text-anchor="middle" class="dfd-label">Payment Store</text><rect x="790" y="92" width="100" height="64" rx="3" class="dfd-entity"></rect><text x="840" y="120" text-anchor="middle" class="dfd-label">Payment</text><text x="840" y="140" text-anchor="middle" class="dfd-sub-label">PROVIDER</text></svg></div><div class="formal-dfd-legend"><span><i class="legend-entity"></i> External entity</span><span><i class="legend-process"></i> Process</span><span><i class="legend-store"></i> Data store</span><span><i class="legend-flow"></i> Labelled data flow</span></div></section><section class="formal-report-section formal-mitigations"><div class="formal-section-title"><span>05</span><h2>Recommended Mitigations</h2></div><ol><li><strong>High Priority · Sessions:</strong> Enforce short-lived, signed JWTs; validate issuer, audience and expiry; require TLS for service-to-service traffic.</li><li><strong>High Priority · Telemetry:</strong> Replace raw identifiers with scoped pseudonyms, redact before log ingestion, apply retention limits and restrict log access.</li><li><strong>High Priority · Event streams:</strong> Drop user-level event streams that are not needed, aggregate or sample telemetry, and restrict access to raw event logs.</li><li><strong>Medium Priority · Webhooks:</strong> Verify HMAC signatures and timestamps before processing; reject stale or duplicate event IDs and add replay-protection tests to CI.</li><li><strong>Medium Priority · Personal Data:</strong> Minimize stored user attributes, document retention periods, and verify encryption and access controls for the user data store.</li></ol></section><footer class="formal-report-footer"><span>RepoPrint · Repository Security &amp; Privacy Audit</span><span>Generated 15 November 2026 · Findings require owner validation</span></footer></main>"`;

exports[`demo instant analysis markup > report 1`] = `"<section class="fingerprint-report" aria-labelledby="fingerprint-title"><div class="report-heading"><div class="report-title-group"><h2 id="fingerprint-title">Repository Fingerprint</h2><div class="report-repo"><svg class="" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.4 1.4-4.4-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.4 6.1-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.5 1.2 15 3a12.6 12.6 0 0 0-6 0C6.5 1.2 5.3 1.5 5.3 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.3 3.1 6.4 6.1 6.7A3.4 3.4 0 0 0 9 18.1V22"></path></svg><strong>deti-org/payment-service</strong><span class="report-mono">SHA <b>a3f89c1</b></span><span class="report-branch"><svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="3" r="2"></circle><circle cx="6" cy="21" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"></path></svg> main</span></div></div><div class="report-actions"><button type="button" class="button button-outline"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"></path></svg> Download Report</button></div></div><div class="framework-cards"><section class="report-panel framework-card"><div class="report-kpi-label"><span class="report-kpi-icon red"><svg class="" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.6 2.4 18a2 2 0 0 0 1.8 3h15.6a2 2 0 0 0 1.8-3L13.7 3.6a2 2 0 0 0-3.4 0Z"></path><path d="M12 9v5m0 3h.01"></path></svg></span> THREAT MODELING · STRIDE</div><div class="report-kpi-value">3 <small>Findings</small></div><div class="report-kpi-foot"><span class="framework-card-tag"><span class="severity-high">1 High</span></span><span class="framework-card-tag"><span class="framework-card-sep">·</span><span class="severity-medium">2 Medium</span></span></div><details class="framework-card-more"><summary aria-label="THREAT MODELING · STRIDE: show breakdown by category"><span class="report-kpi-detail">Spoofing, webhook tampering, information disclosure</span><span class="disclosure-pill"><span class="disclosure-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><ul class="category-chart-list"><li><span class="category-chart-label">Spoofing</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:100%"></span></span><span class="category-chart-count">1</span></li><li><span class="category-chart-label">Tampering</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:100%"></span></span><span class="category-chart-count">1</span></li><li class="is-empty"><span class="category-chart-label">Repudiation</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li><span class="category-chart-label">Information Disclosure</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:100%"></span></span><span class="category-chart-count">1</span></li><li class="is-empty"><span class="category-chart-label">Denial of Service</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li class="is-empty"><span class="category-chart-label">Elevation of Privilege</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar stride" style="width:0%"></span></span><span class="category-chart-count">0</span></li></ul></details></section><section class="report-panel framework-card"><div class="report-kpi-label"><span class="report-kpi-icon orange"><svg class="" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"></path></svg></span> PRIVACY · LINDDUN / GDPR</div><div class="report-kpi-value">2 <small>Findings</small></div><div class="report-kpi-foot"><span class="framework-card-tag"><span class="severity-high">2 High</span></span></div><details class="framework-card-more"><summary aria-label="PRIVACY · LINDDUN / GDPR: show breakdown by category"><span class="report-kpi-detail">Personal identifiers in telemetry and transaction logs</span><span class="disclosure-pill"><span class="disclosure-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><ul class="category-chart-list"><li><span class="category-chart-label">Linkability</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:100%"></span></span><span class="category-chart-count">1</span></li><li class="is-empty"><span class="category-chart-label">Identifiability</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li class="is-empty"><span class="category-chart-label">Non-repudiation</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li><span class="category-chart-label">Detectability</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:100%"></span></span><span class="category-chart-count">1</span></li><li class="is-empty"><span class="category-chart-label">Disclosure of Information</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li class="is-empty"><span class="category-chart-label">Unawareness</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:0%"></span></span><span class="category-chart-count">0</span></li><li class="is-empty"><span class="category-chart-label">Non-compliance</span><span class="category-chart-track" aria-hidden="true"><span class="category-chart-bar linddun" style="width:0%"></span></span><span class="category-chart-count">0</span></li></ul></details></section><article class="report-kpi framework-card hygiene-grade-card"><div class="report-kpi-label"><span class="report-kpi-icon blue"><svg class="" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="3" r="2"></circle><circle cx="6" cy="21" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"></path></svg></span> GIT INTELLIGENCE &amp; HYGIENE</div><div class="report-kpi-value">97 <small>/ 100</small></div><div class="report-kpi-foot">Median PR merge <strong>4.2h</strong></div><div class="report-kpi-foot"><strong>47</strong> commits / month</div><details class="framework-card-more"><summary aria-label="Grade 97 out of 100: show details"><span class="report-kpi-detail">92% Code Owners coverage</span><span class="disclosure-pill"><span class="disclosure-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></span></summary><table class="score-table"><thead><tr><th scope="col">Metric</th><th scope="col">Value</th><th scope="col">Score</th></tr></thead><tbody><tr><th scope="row">Median PR merge time</th><td>4.2h</td><td>100</td></tr><tr><th scope="row">Commits / month</th><td>47</td><td>100</td></tr><tr><th scope="row">Code Owners coverage</th><td>92%</td><td>92</td></tr></tbody></table></details></article></div><section class="report-panel architecture-panel dfd-area"><div class="report-panel-heading"><div><span class="section-kicker">SEMI-AUTOMATED DFD</span><h3>Architecture preview</h3></div><span class="schema-preview">DFD · PREVIEW</span></div><div class="report-architecture"><svg class="formal-dfd preview-formal-dfd" viewBox="0 0 900 270" role="img" aria-label="Data flow diagram showing the customer client, API gateway, payment store and payment provider"><defs><marker id="preview-dfd-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 8 4 0 8Z" fill="#52525b"></path></marker></defs><path d="M145 124H270M410 124H560M700 124H760M825 156C825 225 405 225 405 170" fill="none" stroke="#52525b" stroke-width="2" marker-end="url(#preview-dfd-arrow)"></path><text x="205" y="108" text-anchor="middle">HTTPS / JWT</text><text x="485" y="108" text-anchor="middle">SQL payment data</text><text x="590" y="220" text-anchor="middle">signed webhook event</text><rect x="20" y="92" width="125" height="64" rx="3" class="dfd-entity"></rect><text x="82" y="120" text-anchor="middle" class="dfd-label">Customer Client</text><text x="82" y="140" text-anchor="middle" class="dfd-sub-label">EXTERNAL ENTITY</text><circle cx="340" cy="124" r="70" class="dfd-process"></circle><text x="340" y="120" text-anchor="middle" class="dfd-label">API Gateway</text><text x="340" y="140" text-anchor="middle" class="dfd-sub-label">PROCESS</text><path d="M560 96h140v56H560zM572 106h118M572 142h118" class="dfd-store"></path><text x="630" y="130" text-anchor="middle" class="dfd-label">Payment Store</text><rect x="760" y="92" width="130" height="64" rx="3" class="dfd-entity"></rect><text x="825" y="120" text-anchor="middle" class="dfd-label">Payment Provider</text><text x="825" y="140" text-anchor="middle" class="dfd-sub-label">EXTERNAL ENTITY</text></svg></div><div class="formal-dfd-legend"><span><i class="legend-entity"></i> External entity</span><span><i class="legend-process"></i> Process</span><span><i class="legend-store"></i> Data store</span><span><i class="legend-flow"></i> Labelled data flow</span></div></section><section class="report-panel threats-panel findings-area"><div class="report-panel-heading"><div><span class="section-kicker">THREATS &amp; PRIVACY BREAKDOWN</span><h3>Findings</h3></div><span class="findings-count">05 FINDINGS</span></div><div class="finding-cards" style="--finding-cols:5"><div class="finding-row"><article class="finding-card"><span class="finding-severity-badge high">High</span><span class="finding-card-category">STRIDE · SPOOFING</span><strong class="finding-card-title">Session token spoofing</strong><button type="button" class="finding-details-button">Details <svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></article><article class="finding-card"><span class="finding-severity-badge high">High</span><span class="finding-card-category">LINDDUN · LINKABILITY</span><strong class="finding-card-title">Linkable transaction identifiers</strong><button type="button" class="finding-details-button">Details <svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></article><article class="finding-card"><span class="finding-severity-badge high">High</span><span class="finding-card-category">LINDDUN · DETECTABILITY</span><strong class="finding-card-title">Detectable user activity</strong><button type="button" class="finding-details-button">Details <svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></article><article class="finding-card"><span class="finding-severity-badge medium">Medium</span><span class="finding-card-category">STRIDE · TAMPERING</span><strong class="finding-card-title">Unsigned payload tampering</strong><button type="button" class="finding-details-button">Details <svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></article><article class="finding-card"><span class="finding-severity-badge medium">Medium</span><span class="finding-card-category">STRIDE · INFORMATION DISCLOSURE</span><strong class="finding-card-title">Excess personal data exposure</strong><button type="button" class="finding-details-button">Details <svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></article></div></div></section><div class="report-cta"><span class="report-cta-icon"><svg class="" widt