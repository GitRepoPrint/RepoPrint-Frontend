exports[`instant analysis markup > prints only the Git sections 1`] = `"<link rel="preload" as="image" href="/src/assets/logos/logo_final.png"/><main class="report-document hidden! print:block!" aria-labelledby="formal-report-title"><header class="formal-report-header"><img src="/src/assets/logos/logo_final.png" alt="RepoPrint"/><div class="formal-report-kicker">SECURITY &amp; PRIVACY ASSESSMENT</div><h1 id="formal-report-title">Repository Security &amp; Privacy Audit Report</h1><dl class="report-metadata"><div><dt>Repository</dt><dd>pallets/click</dd></div><div><dt>Branch</dt><dd>main</dd></div><div><dt>Analysis Date</dt><dd>15 November 2026</dd></div></dl></header><section class="formal-report-section"><div class="formal-section-title"><span>01</span><h2>Git Activity</h2></div><table class="formal-table"><tbody><tr><th>Commits / month</th><td>31</td></tr><tr><th>Median PR merge time</th><td>17.5h</td></tr><tr><th>Active contributors</th><td>4</td></tr></tbody></table></section><section class="formal-report-section"><div class="formal-section-title"><span>02</span><h2>Git Data Methodology</h2></div><table class="formal-table"><tbody><tr><th>Commits / month</th><td>31 · Commits in the last 30 days, counted by commit date on the default branch. Merge commits are included.</td></tr><tr><th>Active contributors</th><td>4 · People with commits in the last 90 days. Bots are not counted.</td></tr><tr><th>Median PR merge time</th><td>17.5h (43 PRs) · Median time from opening to merge, over the merged pull requests among the last 100 closed. N/A when none was merged.</td></tr><tr><th>Data</th><td>Read at 10:30 · Read from GitHub just now. Analyzing the same repository again within 10 minutes shows this result.</td></tr></tbody></table></section><footer class="formal-report-footer"><span>RepoPrint · Repository Security &amp; Privacy Audit</span><span>Generated 15 November 2026 · Findings require owner validation</span></footer></main>"`;

exports[`instant analysis markup > shows only the Git numbers and how they are measured 1`] = `"<section class="fingerprint-report" aria-labelledby="fingerprint-title"><div class="report-heading"><div class="report-title-group"><h2 id="fingerprint-title">Repository Fingerprint</h2><div class="report-repo"><svg class="" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.4 1.4-4.4-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.4 6.1-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.5 1.2 15 3a12.6 12.6 0 0 0-6 0C6.5 1.2 5.3 1.5 5.3 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.3 3.1 6.4 6.1 6.7A3.4 3.4 0 0 0 9 18.1V22"></path></svg><strong>pallets/click</strong><span class="report-branch"><svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="3" r="2"></circle><circle cx="6" cy="21" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"></path></svg> main</span></div></div><div class="report-actions"><button type="button" class="button button-outline"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"></path></svg> Download Report</button></div></div><section class="report-panel data-notes-panel" aria-labelledby="data-notes-title"><div class="report-panel-heading"><div><span class="section-kicker">GIT DATA</span><h3 id="data-notes-title">How these numbers are measured</h3></div></div><dl class="data-notes"><div><dt>Commits / month</dt><dd><strong>31</strong><span>Commits in the last 30 days, counted by commit date on the default branch. Merge commits are included.</span></dd></div><div><dt>Active contributors</dt><dd><strong>4</strong><span>People with commits in the last 90 days. Bots are not counted.</span></dd></div><div><dt>Median PR merge time</dt><dd><strong>17.5h (43 PRs)</strong><span>Median time from opening to merge, over the merged pull requests among the last 100 closed. N/A when none was merged.</span></dd></div><div><dt>Data</dt><dd><strong>Read at 10:30</strong><span>Read from GitHub just now. Analyzing the same repository again within 10 minutes shows this result.</span></dd></div></dl></section><div class="report-cta"><span class="report-cta-icon"><svg class="" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"></path></svg></span><p>State-free analysis completed. Long-term metric persistence, commit history, private repository auditing, and manual DFD editing on the canvas require an authenticated session.</p><button type="button" class="button button-primary">Sign In <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></button></div></section>"`;
