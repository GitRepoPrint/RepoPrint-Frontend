exports[`demo dashboard markup > dfd tab 1`] = `"<div class="dfd-tab"><div class="dfd-tab-header"><button type="button" class="button dfd-edit-button"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 5h6v6m0-6-9 9"></path><path d="M19 14v5H5V5h5"></path></svg> Edit DFD in Full Canvas</button></div><section class="dfd-preview-section" aria-label="Inferred Architecture and Data Flow Diagram"><div class="dfd-layout"><div class="dfd-preview"><div class="dfd-preview-viewport"><div class="dfd-preview-scene" style="transform:scale(1)"><svg class="dfd-preview-svg" viewBox="0 0 1000 320" role="img" aria-label="Interactive data flow diagram with external entities, backend processes, data stores and the findings on each component"><defs><marker id="dfd-preview-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 8 4 0 8Z" fill="#85859a"></path></marker></defs><rect class="dfd-trust-boundary" x="272" y="27" width="696" height="274" rx="13"></rect><text class="dfd-boundary-label" x="292" y="49">INTERNAL BACKEND · TRUST BOUNDARY</text><path class="dfd-flow-link" d="M166 132 C220 132 235 117 305 117" marker-end="url(#dfd-preview-arrow)"></path><path class="dfd-flow-link" d="M166 244 C238 244 237 147 305 140" marker-end="url(#dfd-preview-arrow)"></path><path class="dfd-flow-link" d="M390 117 H478" marker-end="url(#dfd-preview-arrow)"></path><path class="dfd-flow-link" d="M555 162 V211" marker-end="url(#dfd-preview-arrow)"></path><path class="dfd-flow-link" d="M632 117 H716" marker-end="url(#dfd-preview-arrow)"></path><path class="dfd-flow-link" d="M800 160 V211" marker-end="url(#dfd-preview-arrow)"></path><g class="dfd-node dfd-node-external risk-none" role="button" tabindex="0" aria-label="Select Client Browser external entity, no findings" aria-pressed="false"><rect x="34" y="105" width="132" height="54" rx="5"></rect><text class="dfd-node-title" x="100" y="128" text-anchor="middle">Client Browser</text><text class="dfd-node-type" x="100" y="145" text-anchor="middle">EXTERNAL ENTITY</text></g><g class="dfd-node dfd-node-external risk-none" role="button" tabindex="0" aria-label="Select External Auth external entity, no findings" aria-pressed="false"><rect x="34" y="217" width="132" height="54" rx="5"></rect><text class="dfd-node-title" x="100" y="240" text-anchor="middle">External Auth</text><text class="dfd-node-type" x="100" y="257" text-anchor="middle">IDENTITY PROVIDER</text></g><g class="dfd-node dfd-node-process risk-high" role="button" tabindex="0" aria-label="Select Auth Gateway process, 1 finding, highest high" aria-pressed="false"><circle cx="348" cy="117" r="43"></circle><text class="dfd-node-title" x="348" y="105" text-anchor="middle">Auth</text><text class="dfd-node-title" x="348" y="120" text-anchor="middle">Gateway</text><text class="dfd-node-type" x="348" y="137" text-anchor="middle">PROCESS</text><g class="dfd-node-badge" aria-hidden="true"><circle cx="379" cy="86" r="11"></circle><text x="379" y="90" text-anchor="middle">1</text></g></g><g class="dfd-node dfd-node-process risk-medium" role="button" tabindex="0" aria-label="Select Payment Engine process, 1 finding, highest medium" aria-pressed="false"><circle cx="555" cy="117" r="43"></circle><text class="dfd-node-title" x="555" y="105" text-anchor="middle">Payment</text><text class="dfd-node-title" x="555" y="120" text-anchor="middle">Engine</text><text class="dfd-node-type" x="555" y="137" text-anchor="middle">PROCESS</text><g class="dfd-node-badge" aria-hidden="true"><circle cx="586" cy="86" r="11"></circle><text x="586" y="90" text-anchor="middle">1</text></g></g><g class="dfd-node dfd-node-process risk-high selected" role="button" tabindex="0" aria-label="Select Telemetry Collector process, 2 findings, highest high" aria-pressed="true"><circle cx="800" cy="117" r="43"></circle><text class="dfd-node-title" x="800" y="105" text-anchor="middle">Telemetry</text><text class="dfd-node-title" x="800" y="120" text-anchor="middle">Collector</text><text class="dfd-node-type" x="800" y="137" text-anchor="middle">PROCESS</text><g class="dfd-node-badge" aria-hidden="true"><circle cx="831" cy="86" r="11"></circle><text x="831" y="90" text-anchor="middle">2</text></g></g><g class="dfd-node dfd-node-store risk-medium" role="button" tabindex="0" aria-label="Select Users DB data store, 1 finding, highest medium" aria-pressed="false"><path d="M482 220 C482 211 514 205 555 205 C596 205 628 211 628 220 V260 C628 269 596 275 555 275 C514 275 482 269 482 260 Z"></path><ellipse cx="555" cy="220" rx="73" ry="15"></ellipse><text class="dfd-node-title" x="555" y="245" text-anchor="middle">Users DB</text><text class="dfd-node-type" x="555" y="261" text-anchor="middle">SENSITIVE DATA</text><g class="dfd-node-badge" aria-hidden="true"><circle cx="621" cy="212" r="11"></circle><text x="621" y="216" text-anchor="middle">1</text></g></g><g class="dfd-node dfd-node-store risk-none" role="button" tabindex="0" aria-label="Select Event Logs data store, no findings" aria-pressed="false"><path d="M727 220 C727 211 759 205 800 205 C841 205 873 211 873 220 V260 C873 269 841 275 800 275 C759 275 727 269 727 260 Z"></path><ellipse cx="800" cy="220" rx="73" ry="15"></ellipse><text class="dfd-node-title" x="800" y="245" text-anchor="middle">Event Logs</text><text class="dfd-node-type" x="800" y="261" text-anchor="middle">TELEMETRY DATA</text></g></svg></div></div><div class="dfd-preview-footer"><ul class="dfd-risk-key" aria-label="Legend"><li><i class="risk-high"></i>High</li><li><i class="risk-medium"></i>Medium</li><li><i class="risk-low"></i>Low</li><li><i class="risk-none"></i>No findings</li><li>Number shows the findings on each component</li></ul><div class="dfd-preview-toolbar" aria-label="Diagram preview controls"><button type="button" title="Zoom out" aria-label="Zoom out"><svg class="" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg></button><span class="dfd-preview-zoom">100%</span><button type="button" title="Zoom in" aria-label="Zoom in"><svg class="" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></button><span class="dfd-toolbar-divider"></span><button type="button" class="dfd-reset-button">Reset View</button><span class="dfd-live-sync"><span></span>Live Sync</span></div></div></div><aside class="dfd-node-panel" aria-live="polite" aria-labelledby="dfd-node-title"><div class="dfd-node-panel-head"><span class="dfd-node-panel-kicker">Selected component</span><h3 id="dfd-node-title">Telemetry Collector</h3><p class="dfd-node-panel-meta">process · Internal service · <code>PR-005</code></p><button type="button" class="button button-primary dfd-node-open">Open in Threat Modeling</button></div><ul class="dfd-node-findings"><li><div class="dfd-node-finding-top"><span class="threat-report-severity high">High</span><strong>Linkable transaction identifiers</strong></div><span>LINDDUN · Linkability</span><code>telemetry/tracker.go</code></li><li><div class="dfd-node-finding-top"><span class="threat-report-severity high">High</span><strong>Detectable user activity</strong></div><span>LINDDUN · Detectability</span><code>telemetry/tracker.go</code></li></ul></aside></div></section></div>"`;

exports[`demo dashboard markup > header 1`] = `"<div class="dashboard-heading"><div class="dashboard-heading-primary"><h1 class="dashboard-repository-title"><button type="button" class="dashboard-back-button" aria-label="Back to repositories" title="Back to repositories"><svg class="" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"></path></svg></button><svg class="" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.4 1.4-4.4-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.4 6.1-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.5 1.2 15 3a12.6 12.6 0 0 0-6 0C6.5 1.2 5.3 1.5 5.3 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.3 3.1 6.4 6.1 6.7A3.4 3.4 0 0 0 9 18.1V22"></path></svg> <span>deti-org/payment-service</span></h1><div class="dashboard-heading-actions"><div class="dashboard-action-buttons"><div class="scan-action"><button type="button" class="button button-primary scan-now"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Zm7 14 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"></path></svg> Scan Now</button><span class="scan-time">Last scanned 2 hours ago</span></div><button type="button" class="button button-outline export-report"><svg class="" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3"></path></svg> Export PDF Report</button></div></div></div><div class="dashboard-controls"><div class="dropdown-wrap"><button type="button" class="branch-button" aria-haspopup="menu" aria-expanded="false"><svg class="" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="3" r="2"></circle><circle cx="6" cy="21" r="2"></circle><circle cx="18" cy="6" r="2"></circle><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"></path></svg> main <svg class="" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div><div class="analysis-history-controls"><label><span>Analysis history</span><select aria-label="Recent analysis history"><option value="scan-14" selected="">Scan #14 — Commit a3f89c1 (main)</option><option value="scan-13">Scan #13 — PR #42</option><option value="scan-12">Scan #12 — Commit a89c01</option></select></label></div></div></div>"`;

exports[`demo dashboard markup > hygiene chart, activity view 1`] = `"<section class="hygiene-chart" aria-labelledby="hygiene-chart-title"><header class="hygiene-chart-header"><h4 id="hygiene-chart-title">Git activity</h4><div class="chart-tabs" role="tablist" aria-label="Chart"><button id="chart-tab-commits" type="button" role="tab" aria-selected="false" aria-controls="hygiene-chart-panel" tabindex="-1" class="chart-tab">Commits per week</button><button id="chart-tab-merge" type="button" role="tab" aria-selected="false" aria-controls="hygiene-chart-panel" tabindex="-1" class="chart-tab">PR merge time</button><button id="chart-tab-activity" type="button" role="tab" aria-selected="true" aria-controls="hygiene-chart-panel" tabindex="0" class="chart-tab active">Activity by day and hour</button></div></header><div id="hygiene-chart-panel" role="tabpanel" aria-labelledby="chart-tab-activity"><figure class="chart-figure"><div class="chart-heat" role="img" aria-label="Commits by day of the week and hour of the day"><div class="chart-heat-row"><span class="chart-heat-day">Mon</span><span class="chart-heat-cell" title="Monday 00:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 01:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 02:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 03:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 04:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 05:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 06:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 07:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 08:00: 2 commits" style="background:color-mix(in srgb, var(--c-accent) 34%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 09:00: 2 commits" style="background:color-mix(in srgb, var(--c-accent) 34%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 10:00: 5 commits" style="background:color-mix(in srgb, var(--c-accent) 59%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 11:00: 8 commits" style="background:color-mix(in srgb, var(--c-accent) 84%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 12:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 13:00: 1 commits" style="background:color-mix(in srgb, var(--c-accent) 26%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 14:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 15:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 16:00: 7 commits" style="background:color-mix(in srgb, var(--c-accent) 75%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 17:00: 6 commits" style="background:color-mix(in srgb, var(--c-accent) 67%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 18:00: 2 commits" style="background:color-mix(in srgb, var(--c-accent) 34%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 19:00: 1 commits" style="background:color-mix(in srgb, var(--c-accent) 26%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 20:00: 2 commits" style="background:color-mix(in srgb, var(--c-accent) 34%, var(--c-surface))"></span><span class="chart-heat-cell" title="Monday 21:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 22:00: 0 commits"></span><span class="chart-heat-cell" title="Monday 23:00: 0 commits"></span></div><div class="chart-heat-row"><span class="chart-heat-day">Tue</span><span class="chart-heat-cell" title="Tuesday 00:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 01:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 02:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 03:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 04:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 05:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 06:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 07:00: 0 commits"></span><span class="chart-heat-cell" title="Tuesday 08:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 09:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 10:00: 7 commits" style="background:color-mix(in srgb, var(--c-accent) 75%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 11:00: 10 commits" style="background:color-mix(in srgb, var(--c-accent) 100%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 12:00: 6 commits" style="background:color-mix(in srgb, var(--c-accent) 67%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 13:00: 3 commits" style="background:color-mix(in srgb, var(--c-accent) 43%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 14:00: 6 commits" style="background:color-mix(in srgb, var(--c-accent) 67%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 15:00: 6 commits" style="background:color-mix(in srgb, var(--c-accent) 67%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 16:00: 9 commits" style="background:color-mix(in srgb, var(--c-accent) 92%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 17:00: 8 commits" style="background:color-mix(in srgb, var(--c-accent) 84%, var(--c-surface))"></span><span class="chart-heat-cell" title="Tuesday 18:00: 4 commits" style="background:color-mix(in srgb, var(--c-accent) 51%, var(--c-surface))"></span>