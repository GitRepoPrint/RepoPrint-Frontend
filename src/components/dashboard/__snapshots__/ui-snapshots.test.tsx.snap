exports[`demo dashboard markup > printed report 1`] = `"<link rel="preload" as="image" href="/src/assets/logos/logo_final.png"/><main class="report-document hidden! print:block!" aria-labelledby="formal-report-title"><header class="formal-report-header"><img src="/src/assets/logos/logo_final.png" alt="RepoPrint"/><div class="formal-report-kicker">SECURITY &amp; PRIVACY ASSESSMENT</div><h1 id="formal-report-title">Repository Security &amp; Privacy Audit Report</h1><dl class="report-metadata"><div><dt>Repository</dt><dd>deti-org/payment-service</dd></div><div><dt>Branch</dt><dd>main</dd></div><div><dt>Commit Hash</dt><dd>a3f89c1</dd></div><div><dt>Analysis Date</dt><dd>26 October 2026</dd></div></dl></header><section class="formal-report-section"><div class="formal-section-title"><span>01</span><h2>Executive Summary &amp; Risk Overview</h2></div><p class="report-lead">The primary residual risks concern session integrity, webhook validation, and the correlation of personal identifiers in telemetry and transaction logs.</p><table class="formal-table"><thead><tr><th>Component</th><th>Risk</th><th>Impact</th><th>Fix effort</th></tr></thead><tbody><tr><td>Auth Gateway</td><td>Session token spoofing</td><td>High · unauthorized access</td><td>Medium · 1-2 days</td></tr><tr><td>Payment Engine</td><td>Unsigned payload tampering</td><td>High · payment integrity</td><td>Low · ~4 hours</td></tr><tr><td>Users DB</td><td>Excess personal data exposure</td><td>Medium · privacy breach</td><td>High · 1-2 weeks</td></tr><tr><td>Telemetry Collector</td><td>Linkable transaction identifiers</td><td>High · user profiling</td><td>Medium · 2-3 days</td></tr><tr><td>Telemetry Collector</td><td>Detectable user activity</td><td>High · behavior inference</td><td>Medium · 2-3 days</td></tr></tbody></table></section><section class="formal-report-section"><div class="formal-section-title"><span>02</span><h2>Threat Modeling Findings (STRIDE)</h2></div><table class="formal-table"><thead><tr><th>Threat</th><th>Affected file / flow</th><th>Severity</th><th>Impact</th><th>Regulatory controls</th></tr></thead><tbody><tr><td>Spoofing</td><td><code>auth/session.ts</code> · client to API</td><td class="formal-high">High</td><td>Session impersonation and unauthorized account access</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.5.17</td></tr><tr><td>Tampering</td><td><code>payments/webhooks.ts</code> · inbound webhook</td><td class="formal-medium">Medium</td><td>Forged or replayed payment events</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.8.26</td></tr><tr><td>Information Disclosure</td><td><code>storage/users.db</code> · user data store</td><td class="formal-medium">Medium</td><td>Over-exposed personal attributes can be leaked in a data breach</td><td>NIS 2 Art. 21; ISO/IEC 27001 A.8.12</td></tr></tbody></table></section><section class="formal-report-section"><div class="formal-section-title"><span>03</span><h2>Privacy Risk Assessment (LINDDUN)</h2></div><table class="formal-table"><thead><tr><th>Privacy Threat (LINDDUN GO)</th><th>Affected component</th><th>Hotspot</th><th>Description</th></tr></thead><tbody><tr><td><strong>Linkability</strong> [L-004]</td><td>Telemetry Collector · <code>telemetry/tracker.go</code></td><td>Telemetry</td><td>Exposure of correlatable personal and transaction data</td></tr><tr><td><strong>Detectability</strong> [D-005]</td><td>Telemetry Collector · <code>telemetry/tracker.go</code></td><td>Event streams</td><td>User presence and behavior can be inferred from telemetry events</td></tr></tbody></table></section><section class="formal-report-section formal-dfd-section"><div class="formal-section-title"><span>04</span><h2>Inferred Architecture &amp; Data Flow Diagram (DFD)</h2></div><p>Primary payment and identity flows inferred from repository structure and analysis findings.</p><div class="formal-dfd-wrap"><svg class="formal-dfd" viewBox="0 0 900 270" role="img" aria-label="DFD: customer client sends authenticated requests to API gateway, which reads and writes payment data in PostgreSQL; webhook provider sends payment events to the gateway"><defs><marker id="formal-dfd-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 8 4 0 8Z" fill="#52525b"></path></marker></defs><path d="M145 124H270M410 124H560M700 124H790M790 178C790 225 405 225 405 170" fill="none" stroke="#52525b" stroke-width="2" marker-end="url(#formal-dfd-arrow)"></path><text x="205" y="108" text-anchor="middle">HTTPS / JWT</text><text x="485" y="108" text-anchor="middle">SQL · payment data</text><text x="748" y="108" text-anchor="middle">write / read</text><text x="590" y="220" text-anchor="middle">signed webhook event</text><rect x="20" y="92" width="125" height="64" rx="3" class="dfd-entity"></rect><text x="82" y="120" text-anchor="middle" class="dfd-label">Customer Client</text><text x="82" y="140" text-anchor="middle" class="dfd-sub-label">EXTERNAL ENTITY</text><circle cx="340" cy="124" r="70" class="dfd-process"></circle><text x="340" y="120" text-anchor="middle" class="dfd-label">API Gateway</text><text x="340" y="140" text-anchor="middle" class="dfd-sub-label">PROCESS</text><path d="M560 96h140v56H560zM572 106h118M572 142h118" class="dfd-store"></path><text x="630" y="130" text-anchor="middle" class="dfd-label">Payment Store</text><rect x="790" y="92" width="100" height="64" rx="3" class="dfd-entity"></rect><text x="840" y="120" text-anchor="middle" class="dfd-label">Payment</text><text x="840" y="140" text-anchor="middle" class="dfd-sub-label">PROVIDER</text></svg></div><div class="formal-dfd-legend"><span><i class="legend-entity"></i> External entity</span><span><i class="legend-process"></i> Process</span><span><i class="legend-store"></i> Data store</span><span><i class="legend-flow"></i> Labelled data flow</span></div></section><section class="formal-report-section"><div class="formal-section-title"><span>05</span><h2>Team Cadence &amp; Structural Hygiene</h2></div><table class="formal-table"><tbody><tr><th>Repository activity</th><td>47 commits in the last 30 days · median merge time 4.2h · Code Owners coverage 92%</td></tr><tr><th>Contributors</th><td>Marta Costa (142 commits), João Lima (98 commits), Ana Silva (76 commits), Rui Pereira (54 commits)</td></tr><tr><th>Branches</th><td><code>main</code> (default, protected)<span> · <code>release/v2</code> (protected)</span><span> · 12 other branches not protected</span></td></tr><tr><th>Languages</th><td>TypeScript 68% · Go 22% · SQL 10%</td></tr><tr><th>Tests / CI</th><td>86% test coverage · CI checks passing on the latest analyzed commit</td></tr></tbody></table></section><section class="formal-report-section formal-mitigations"><div class="formal-section-title"><span>06</span><h2>Recommended Mitigations</h2></div><ol><li><strong>High Priority · Sessions:</strong> Enforce short-lived, signed JWTs; validate issuer, audience and expiry; require TLS for service-to-service traffic.</li><li><strong>High Priority · Telemetry:</strong> Replace raw identifiers with scoped pseudonyms, redact before log ingestion, apply retention limits and restrict log access.</li><li><strong>High Priority · Event streams:</strong> Drop user-level event streams that are not needed, aggregate or sample telemetry, and restrict access to raw event logs.</li><li><strong>Medium Priority · Webhooks:</strong> Verify HMAC signatures and timestamps before processing; reject stale or duplicate event IDs and add replay-protection tests to CI.</li><li><strong>Medium Priority · Personal Data:</strong> Minimize stored user attributes, document retention periods, and verify encryption and access controls for the user data store.</li></ol></section><footer class="formal-report-footer"><span>RepoPrint · Repository Security &amp; Privacy Audit</span><span>Generated 26 October 2026 · Findings require owner validation</span></footer></main>"`;

exports[`demo dashboard markup > team tab 1`] = `"<section class="dashboard-section team-page" aria-label="Team Dynamics and Repository Hygiene"><section class="team-box" aria-labelledby="team-activity-title"><header class="team-box-header"><div><h3 id="team-activity-title">Team activity</h3><p>Commits, pull request reviews and code ownership in the last 30 days.</p></div><span class="team-chip neutral">4 active contributors</span></header><div class="team-stats"><div class="team-stat"><span class="team-stat-label">Average commits per week</span><strong>11</strong><span class="team-chip neutral">Stable</span></div><div class="team-stat"><span class="team-stat-label">Median PR merge time</span><strong>4.2h</strong><span class="team-chip neutral">Fast turnaround</span></div><div class="team-stat"><span class="team-stat-label">Code Owners coverage</span><strong>92%</strong><span class="team-chip good">Enforced</span></div></div><div class="team-table-wrap"><table class="team-table"><thead><tr><th scope="col">Contributor</th><th scope="col">Commits</th><th scope="col">Review participation</th><th scope="col">Code ownership</th></tr></thead><tbody><tr><td><div class="team-person"><span class="avatar lavender">MC</span><div><strong>Marta Costa</strong><small>Maintainer</small></div></div></td><td>142</td><td><div class="team-review"><span class="team-review-bar" aria-hidden="true"><span style="width:94%"></span></span><strong>94%</strong></div></td><td>Core / Payments</td></tr><tr><td><div class="team-person"><span class="avatar peach">JL</span><div><strong>João Lima</strong><small>Backend</small></div></div></td><td>98</td><td><div class="team-review"><span class="team-review-bar" aria-hidden="true"><span style="width:88%"></span></span><strong>88%</strong></div></td><td>Auth / API Gateway</td></tr><tr><td><div class="team-person"><span class="avatar mint">AS</span><div><strong>Ana Silva</strong><small>Security</small></div></div></td><td>76</td><td><div class="team-review"><span class="team-review-bar" aria-hidden="true"><span style="width:97%"></span></span><strong>97%</strong></div></td><td>Policies / Telemetry</td></tr><tr><td><div class="team-person"><span class="avatar blue">RP</span><div><strong>Rui Pereira</strong><small>Frontend</small></div></div></td><td>54</td><td><div class="team-review"><span class="team-review-bar" aria-hidden="true"><span style="width:81%"></span></span><strong>81%</strong></div></td><td>Client / Webhooks</td></tr></tbody></table></div></section><section class="team-box" aria-labelledby="repo-hygiene-title"><header class="team-box-header"><div><h3 id="repo-hygiene-title">Repository hygiene</h3><p>Branch rules, tests and license found through the GitHub API.</p></div></header><div class="hygiene-overview"><section class="hygiene-chart" aria-labelledby="hygiene-chart-title"><header class="hygiene-chart-header"><h4 id="hygiene-chart-title">Git activity</h4><div class="chart-tabs" role="tablist" aria-label="Chart"><button id="chart-tab-commits" type="button" role="tab" aria-selected="true" aria-controls="hygiene-chart-panel" tabindex="0" class="chart-tab active">Commits per week</button><button id="chart-tab-merge" type="button" role="tab" aria-selected="false" aria-controls="hygiene-chart-panel" tabindex="-1" class="chart-tab">PR merge time</button><button id="chart-tab-activity" type="button" role="tab" aria-selected="false" aria-controls="hygiene-chart-panel" tabindex="-1" class="chart-tab">Activity by day and hour</button></div></header><div id="hygiene-chart-panel" role="tabpanel" aria-labelledby="chart-tab-commits"><figure class="chart-figure"><div class="chart-plot" role="img" aria-label="Average, 11 commits per week: 8, 12, 9, 14, 11, 7, 13, 10, 12, 11, 13, 11 commits"><span class="chart-line" style="bottom:66.5859564164649%"></span><span class="chart-column" title="8 commits"><span class="chart-bar" style="height:48.426150121065376%"><b>8</b></span></span><span class="chart-column" title="12 commits"><span class="chart-bar" style="height:72.63922518159806%"><b>12</b></span></span><span class="chart-column" title="9 commits"><span class="chart-bar" style="height:54.47941888619855%"><b>9</b></span></span><span class="chart-column" title="14 commits"><span class="chart-bar" style="height:84.74576271186442%"><b>14</b></span></span><span class="chart-column" title="11 commits"><span class="chart-bar" style="height:66.5859564164649%"><b>11</b></span></span><span class="chart-column" title="7 commits"><span class="chart-bar" style="height:42.37288135593221%"><b>7</b></span></span><span class="chart-column" title="13 commits"><span class="chart-bar" style="height:78.69249394673123%"><b>13</b></span></span><span class="chart-column" title="10 commits"><span class="chart-bar" style="height:60.53268765133172%"><b>10</b></span></span><span class="chart-column" title="12 commits"><span class="chart-bar" style="height:72.63922518159806%"><b>12</b></span></span><span class="chart-column" title="11 commits"><span class="chart-bar" style="height:66.5859564164649%"><b>11</b></span></span><span class="chart-column" title="13 commits"><span class="chart-bar" style="height:78.69249394673123%"><b>13</b></span></span><span class="chart-column" title="11 commits"><span class="chart-bar" style="height:66.5859564164649%"><b>11</b></span></span></div><div class="chart-axis"><span>12 weeks ago</span><span>This week</span></div><figcaption class="chart-legend"><span class="chart-legend-line" aria-hidden="true"></span>Average, 11 commits per week</figcaption></figure><p class="chart-summary">Average of 11 commits per week over the last 12 weeks. Busiest week: 14 commits.</p></div></section><div class="hygiene-grade" role="img" aria-label="Git hygiene grade 97 out of 100"><strong>97</strong><span>/ 100</span><small>Git hygiene grade</small></div></div><div class="hygiene-checks"><article class="hygiene-check tall"><header class="hygiene-check-header"><h4>Branch protection</h4><span class="team-chip good">Protected</span></header><dl class="branch-info"><div><dt>Default branch</dt><dd><code>main</code></dd></div><div><dt>Rules</dt><dd><ul class="branch-rules"><li><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Require pull request reviews before merging (1 approval)</li><li><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>Enforce status checks</li></ul></dd></div><div><dt>Also protected</dt><dd><ul class="branch-chips"><li><code>release/v2</code></li></ul></dd></div><div><dt>Not protected</dt><dd>12 other branches</dd></div></dl></article><article class="hygiene-check"><header class="hygiene-check-header"><h4>Tests and CI</h4><span class="team-chip good">Passing</span></header><p class="hygiene-check-value">86% test coverage</p><div class="hygiene-bar" role="img" aria-label="Test coverage: 86 percent"><span style="width:86%"></span></div></article><article class="hygiene-check"><header class="hygiene-check-header"><h4>License</h4><span class="team-chip neutral">OSI approved</span></header><p class="hygiene-check-value">MIT License</p><p class="hygiene-ok"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg> Allows commercial use</p></article></div></section></section>"`;

exports[`demo dashboard markup > threats tab 1`] = `"<div class="threat-report-view"><section class="formal-report-section"><div class="formal-section-title"><span>01</span><h2>Executive Summary &amp; Risk Overview</h2></div><div class="threat-report-summary"><p style="color:var(--c-text-2, #71717a)">No executive summary available.</p></div><div class="threat-report-table-wrap"><table class="formal-table"><thead><tr><th>Component / File</th><th>Risk</th><th>Impact</th><th>Probability</th></tr></thead><tbody><tr><td colSpan="4" style="text-align:center;padding:28px 16px;color:var(--c-text-2, #71717a)">No risk overview data available.</td></tr></tbody></table></div></section><section class="formal-report-section"><div class="formal-section-title"><span>02</span><h2>Threat Modeling Findings (STRIDE)</h2></div><div class="threat-report-table-wrap"><table class="formal-table"><thead><tr><th>Threat</th><th>Affected file / flow</th><th class="threat-report-severity-cell">Severity</th><th>Impact</th><th>Regulatory controls</th><th>Actions</th></tr></thead><tbody><tr><td colSpan="6" style="text-align:center;padding:32px 16px;color:var(--c-text-2, #71717a)">No STRIDE threat modeling findings available.</td></tr></tbody></table></div></section><section class="formal-report-section"><div class="formal-section-title"><span>03</span><h2>Privacy Threat Modeling (LINDDUN GO)</h2></div><div class="threat-report-table-wrap"><table class="formal-table formal-table-linddun"><thead><tr><th class="col-threat">Privacy Threat / Card</th><th class="col-component">Affected component</th><th class="col-hotspot">Hotspot</th><th class="col-source">Threat source</th><th class="col-desc">Description &amp; Consequences</th><th class="col-actions">Actions</th></tr></thead><tbody><tr><td><strong>Linkability</strong><div class="threat-report-context">[L-004] Linkable transaction identifiers</div></td><td><code>telemetry/tracker.go</code> <span class="threat-report-context">(Telemetry Collector)</span></td><td><span class="threat-report-hotspot-badge">Telemetry</span></td><td><div class="threat-report-tags"><span class="threat-report-tag">Organizational</span></div></td><td><div class="threat-report-desc">Exposure of correlatable personal and transaction data</div></td><td class="threat-report-action-cell"><button type="button" class="threat-report-action disabled" disabled="" title="Not available yet">Mark as False Positive</button></td></tr><tr><td><strong>Detectability</strong><div class="threat-report-context">[D-005] Detectable user activity</div></td><td><code>telemetry/tracker.go</code> <span class="threat-report-context">(Telemetry Collector)</span></td><td><span class="threat-report-hotspot-badge">Event streams</span></td><td><div class="threat-report-tags"><span class="threat-report-tag">Organizational</span></div></td><td><div class="threat-report-desc">User presence and behavior can be inferred from telemetry events</div></td><td class="threat-report-action-cell"><button type="button" class="threat-report-action disabled" disabled="" title="Not available yet">Mark as False Positive</button></td></tr></tbody></table></div></section><section class="formal-report-section"><div class="formal-section-title"><span>06</span><h2>AI-Assisted Mitigations (SLM Recommendations)</h2></div><div class="threat-report-summary" style="margin:0"><p style="color:var(--c-text-2, #71717a)">Not available</p></div></section></div>"`;
